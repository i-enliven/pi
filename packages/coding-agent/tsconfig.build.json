{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"paths": {
			"@i-enliven/pi-agent-core": [
				"../agent/dist/index.d.ts"
			],
			"@i-enliven/pi-agent-core/*": [
				"../agent/dist/*.d.ts"
			],
			"@i-enliven/pi-ai": [
				"../ai/dist/index.d.ts"
			],
			"@i-enliven/pi-ai/*": [
				"../ai/dist/*.d.ts",
				"../ai/dist/providers/*.d.ts"
			],
			"@i-enliven/pi-tui": [
				"../tui/dist/index.d.ts"
			],
			"@i-enliven/pi-tui/*": [
				"../tui/dist/*.d.ts",
				"../tui/dist/components/*.d.ts"
			]
		},
		"rootDir": "./src"
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.d.ts"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}