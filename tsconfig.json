{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"@i-enliven/pi-telemetry": [
				"./packages/telemetry/src/index.ts"
			],
			"@i-enliven/pi-telemetry/testing": [
				"./packages/telemetry/src/testing/index.ts"
			],
			"@i-enliven/pi-mcp": [
				"./packages/mcp/src/index.ts"
			],
			"@i-enliven/pi-mcp/oauth": [
				"./packages/mcp/src/oauth/index.ts"
			],
			"@i-enliven/pi-mcp/testing": [
				"./packages/mcp/src/testing/index.ts"
			],
			"@i-enliven/pi-ai": [
				"./packages/ai/src/index.ts"
			],
			"@i-enliven/pi-ai/oauth": [
				"./packages/ai/src/oauth.ts"
			],
			"@i-enliven/pi-ai/*": [
				"./packages/ai/src/*.ts",
				"./packages/ai/src/providers/*.ts"
			],
			"@i-enliven/pi-ai/dist/*": [
				"./packages/ai/src/*"
			],
			"@i-enliven/pi-agent-core": [
				"./packages/agent/src/index.ts"
			],
			"@i-enliven/pi-coding-agent": [
				"./packages/coding-agent/src/index.ts"
			],
			"@i-enliven/pi-coding-agent/hooks": [
				"./packages/coding-agent/src/core/hooks/index.ts"
			],
			"@i-enliven/pi-coding-agent/*": [
				"./packages/coding-agent/src/*"
			],
			"typebox": [
				"./node_modules/typebox"
			],
			"@i-enliven/pi-tui": [
				"./packages/tui/src/index.ts"
			],
			"@i-enliven/pi-tui/*": [
				"./packages/tui/src/*"
			],
			"@i-enliven/pi-agent-old": [
				"./packages/agent-old/src/index.ts"
			],
			"@i-enliven/pi-agent-old/*": [
				"./packages/agent-old/src/*"
			]
		}
	},
	"include": [
		"packages/*/src/**/*",
		"packages/*/test/**/*",
		"packages/coding-agent/examples/**/*",
		"packages/agent/examples/**/*"
	],
	"exclude": [
		"**/dist/**",
		"packages/coding-agent/examples/extensions/gondolin/**"
	]
}